# Configuration for CRM-DAM. Docker Compose works without a .env file: the values below are
# the defaults it uses. To change one, copy this file to .env and edit it; .env is never committed.
# DATABASE_URL, TEST_DATABASE_URL and FILE_STORE_DIR are fixed by Compose for its containers, so .env
# does not change them there. The tests always use the mock AI provider.

# Database. Host "db" exists only inside Compose; the database port is not published to the host.
DATABASE_URL=postgres://crm_dam:crm_dam@db:5432/crm_dam
TEST_DATABASE_URL=postgres://crm_dam:crm_dam@db:5432/crm_dam_test

# Address the browser uses for the app. State-changing requests from any other Origin are rejected.
APP_ORIGIN=http://localhost:3000

# Where uploaded originals and derived files are stored. Compose mounts a volume here.
FILE_STORE_DIR=/var/lib/crm-dam/files

# Image metadata provider: "mock" (default, no key needed). "claude" arrives with Story 3.5; until
# then any value other than "mock" makes generation fail.
AI_PROVIDER=mock
# Needed only when AI_PROVIDER=claude (Story 3.5). Never commit a real key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=medium

# Mock provider: delay per image in milliseconds, and "true" to make every generation fail.
MOCK_DELAY_MS=1500
MOCK_FAIL=false

# Number of images the background worker generates metadata for at once (FR-15).
WORKER_CONCURRENCY=2

# Seed demo users and sample images on an empty database. Development and tests only; turn off for real use.
SEED_ON_START=true

# 32-byte key, base64, that encrypts an AI key saved in Settings (FR-39). Empty until that feature is used.
APP_ENCRYPTION_KEY=
